# Needed for testing our workflows
# The `full` variants are needed for:
# * Maven for TeamCity configuration validation
# * `shellcheck`
-P ubuntu-latest=ghcr.io/catthehacker/ubuntu:full-24.04
-P custom-ubuntu-22.04-medium=ghcr.io/catthehacker/ubuntu:act-22.04
-P custom-ubuntu-22.04-large=ghcr.io/catthehacker/ubuntu:act-22.04
-P custom-ubuntu-22.04-xl=ghcr.io/catthehacker/ubuntu:act-22.04
